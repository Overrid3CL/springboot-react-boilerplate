# WorkOS AuthKit. El client id es público; no commitees un .env con valores reales.
WORKOS_CLIENT_ID=
WORKOS_ISSUER=https://api.workos.com
# Opcional. Si lo defines, el JWT debe traer ese valor en aud (plantilla JWT del dashboard).
WORKOS_AUDIENCE=
# Opcional. Por defecto https://api.workos.com/sso/jwks/$WORKOS_CLIENT_ID
WORKOS_JWKS_URI=
# Dominio de autenticación propio. Déjalo vacío para usar api.workos.com.
WORKOS_API_HOSTNAME=
# Opcional. Si está vacío, la SPA usa el origen del navegador.
WORKOS_REDIRECT_URI=

# Postgres local (compose.yaml). En Coolify apunta al servicio de base de datos.
POSTGRES_DB=boilerplate
POSTGRES_USER=boilerplate
POSTGRES_PASSWORD=boilerplate
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/boilerplate
SPRING_DATASOURCE_USERNAME=boilerplate
SPRING_DATASOURCE_PASSWORD=boilerplate

# OpenTelemetry. Quedan apagados hasta que los actives.
OTLP_METRICS_ENABLED=false
OTLP_METRICS_URL=http://localhost:4318/v1/metrics
OTLP_TRACES_ENABLED=false
OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
OTLP_LOGS_ENABLED=false
OTLP_LOGS_ENDPOINT=http://localhost:4318/v1/logs
